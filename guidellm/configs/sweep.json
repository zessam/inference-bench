{
  "metadata": {
    "name": "sweep",
    "description": "Synchronous, throughput, then evenly spaced rates in between."
  },
  "spec": {
    "backend": {
      "kind": "openai_http",
      "request_format": "/v1/chat/completions"
    },
    "profile": {
      "kind": "sweep",
      "sweep_size": 10,
      "strategy_type": "constant"
    },
    "data": [
      {
        "kind": "synthetic_text",
        "prompt_tokens": 256,
        "output_tokens": 128
      }
    ],
    "constraints": [
      {
        "kind": "max_duration",
        "seconds": 30
      },
      {
        "kind": "max_error_rate",
        "rate": 0.1
      }
    ]
  }
}
