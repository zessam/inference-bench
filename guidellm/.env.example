# Endpoint under test, without /v1, e.g. https://YOUR-SERVER or
# http://YOUR-SERVER:8000. A server on this machine is reachable as
# http://host.docker.internal:8000
VLLM_BASE_URL=http://YOUR-SERVER:8000
# The key vLLM was started with (--api-key / VLLM_API_KEY)
VLLM_API_KEY=your_vllm_api_key
# Must match the id from GET <VLLM_BASE_URL>/v1/models
VLLM_MODEL=YOUR-MODEL-ID

# Profiles to run when none are given on the command line:
# all, or a comma list of synchronous,throughput,concurrent,poisson,sweep,replay
PROFILES=all

# Optional
# RUN_ID=                   # results folder name (default: timestamp)
# RESULTS_DIR=              # where reports go (default: the folder you run from)
# HF_TOKEN=                 # only for gated tokenizers
# GUIDELLM_VERSION=v0.8.0   # image tag; configs/ use the 0.8 format
