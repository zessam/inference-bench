# vLLM server to scrape: host[:port], no scheme or path (Prometheus adds /metrics).
#   Remote server: YOUR-SERVER:8000, or YOUR-SERVER with scheme https
#   This machine:  host.docker.internal:8000
VLLM_METRICS_TARGET=YOUR-SERVER:8000
# http, or https when the server is behind HTTPS
VLLM_METRICS_SCHEME=http

# Grafana login
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
